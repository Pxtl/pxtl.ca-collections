<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Version.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>    
  </PropertyGroup>

  <PropertyGroup>
    <ProjectGuid>668de199-9787-4f1c-b3cb-c0a5cf9732a7</ProjectGuid>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Packagedoc>README.md</Packagedoc>
    <PackageId>PxtlCa.Collections.Proxies</PackageId>
    <Authors>Martin Zarate (AKA Pxtl)</Authors>
    <Description>
      It is a set of pseudo-pointer generics in C#.  I don't really remember
      what I was going for with these.  This may be mostly an artifact of .NET
      2.0 since `Expression` objects have replaced the need for that generally.
      This assembly should be mostly considered experimental.
    </Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Pxtl/pxtl.ca-collections</PackageProjectUrl>
    <RepositoryUrl>$(PackageProjectUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>netstandard2.0 object proxies collections</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polyfill" Version="10.11.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Collections" Version="4.3.0" />
    <PackageReference Include="System.Linq" Version="4.3.0" />
  </ItemGroup>
  <PropertyGroup>
    <PolyEnsure>true</PolyEnsure>
  </PropertyGroup>

  <!-- <ItemGroup>
    <ProjectReference Include="..\Collections\PxtlCa.Collections.csproj" />
  </ItemGroup> -->

  <!-- coding standards -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="True" PackagePath="" />
    <None Include="../LICENSE" Pack="True" PackagePath="" />
  </ItemGroup>

</Project>
